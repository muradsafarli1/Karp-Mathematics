{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "/app.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/exam.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/exams.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/contests.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/admin.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/problems",
        "destination": "/problems.html"
      },
      {
        "source": "/contests",
        "destination": "/contests.html"
      },
      {
        "source": "/articles",
        "destination": "/articles.html"
      },
      {
        "source": "/exams",
        "destination": "/exams.html"
      },
      {
        "source": "/videos",
        "destination": "/videos.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/account",
        "destination": "/account.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/signup",
        "destination": "/signup.html"
      },
      {
        "source": "/problem",
        "destination": "/problem.html"
      },
      {
        "source": "/contest",
        "destination": "/contest.html"
      },
      {
        "source": "/article",
        "destination": "/article.html"
      },
      {
        "source": "/exam",
        "destination": "/exam.html"
      },
      {
        "source": "/geogebra",
        "destination": "/geogebra.html"
      },
      {
        "source": "/calculator",
        "destination": "/calculator.html"
      },
      {
        "source": "/desmos",
        "destination": "/desmos.html"
      },
      {
        "source": "/mock",
        "destination": "/mock.html"
      },
      {
        "source": "/mathnet-sync",
        "destination": "/mathnet-sync.html"
      },
      {
        "source": "/journal",
        "destination": "/journal.html"
      },
      {
        "source": "/meetings",
        "destination": "/meetings.html"
      },
      {
        "source": "/meeting",
        "destination": "/meeting.html"
      },
      {
        "source": "/books",
        "destination": "/books.html"
      },
      {
        "source": "/book",
        "destination": "/book.html"
      }
    ],
    "redirects": [
      {
        "source": "/firebase.js",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/hosting",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/hosting/**",
        "destination": "/",
        "type": 302
      }
    ]
  }
}
