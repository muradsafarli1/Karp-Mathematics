rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedAccount(uid) {
      return signedIn()
        && (
          request.auth.token.email_verified == true
          || (
            exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.requiresEmailVerification != true
          )
        );
    }
    function isAdminUid(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function friendshipId(a,b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(a,b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a,b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a,b))).data.status == 'accepted';
    }
    function conversationMember(data) {
      return signedIn() && data.members is list && request.auth.uid in data.members;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && (
          (request.auth.token.email_verified == true
            && request.resource.data.requiresEmailVerification == false)
          ||
          (request.auth.token.email_verified != true
            && request.resource.data.requiresEmailVerification == true)
        );
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiresEmailVerification'])
            || (
              request.auth.token.email_verified == true
              && request.resource.data.requiresEmailVerification == false
            )
          ));
      allow delete: if isAdmin();

      match /solved/{problemId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /saved/{problemId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /mockHistory/{mockId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /privateState/{stateId} {
        allow read, create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /readMarks/{markId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /examEntries/{examId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /examSessions/{sessionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if isAdmin() || signedIn();
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin() || (verifiedAccount(uid) && request.auth.uid == uid);
    }

    match /friendRequests/{requestId} {
      allow read: if isAdmin() || signedIn();
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid));
      allow update: if isAdmin()
        || (signedIn() && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status in ['accepted','rejected'])
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'cancelled')
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status in ['rejected','cancelled']
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'pending')
        ));
      allow delete: if isAdmin();
    }

    match /friendships/{friendshipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.members is list && request.auth.uid in resource.data.members);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] != request.resource.data.members[1]
          && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId))
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.toUid in request.resource.data.members
          && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.fromUid in request.resource.data.members);
      allow update: if isAdmin()
        || (verifiedAccount(request.auth.uid)
          && resource.data.members is list
          && request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && request.resource.data.status == resource.data.status
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt','updatedAt']));
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.members is list && request.auth.uid in resource.data.members);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 20
          && request.auth.uid in request.resource.data.members
          && (
            (request.resource.data.type == 'direct'
              && request.resource.data.members.size() == 2
              && conversationId == friendshipId(request.resource.data.members[0],request.resource.data.members[1])
              && isFriend(request.resource.data.members[0],request.resource.data.members[1]))
            ||
            (request.resource.data.type == 'group'
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 1
              && request.resource.data.name.size() <= 80)
            ||
            (request.resource.data.type == 'support'
              && request.resource.data.members.size() == 2
              && request.resource.data.createdBy == request.auth.uid
              && (isAdminUid(request.resource.data.members[0]) || isAdminUid(request.resource.data.members[1])))
          ));
      allow update: if isAdmin()
        || (conversationMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data));
        allow create: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000);
        allow update, delete: if isAdmin();
      }
    }

    // KARP Chat: public community discussions and a real-time general room.
    match /chatPosts/{postId} {
      allow read: if true;
      allow create: if verifiedAccount(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 12000
        && request.resource.data.tag is string
        && request.resource.data.tag.size() <= 40
        && request.resource.data.score == 0
        && request.resource.data.solved == false;
      allow update: if isAdmin()
        || (verifiedAccount(request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
          && request.resource.data.score == resource.data.score + 1);
      allow delete: if isAdmin();
      match /comments/{commentId} {
        allow read: if true;
        allow create: if verifiedAccount(request.auth.uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if isAdmin();
      }
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if verifiedAccount(request.auth.uid)
        && roomId == 'general'
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if isAdmin();
    }

    match /presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if (signedIn() && request.auth.uid == uid)
        || (!signedIn()
          && uid.matches('guest_[A-Za-z0-9_-]+')
          && request.resource.data.guestId == uid
          && request.resource.data.uid == null
          && request.resource.data.userType == 'guest');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // One document per visitor session. Used for unique daily/monthly/yearly visitor analytics.
    match /visitorVisits/{visitId} {
      allow read: if isAdmin();
      allow create, update: if (
        signedIn()
        && request.resource.data.userType == 'account'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.dateKey is string
        && request.resource.data.enteredAt is timestamp
      ) || (
        !signedIn()
        && request.resource.data.userType == 'guest'
        && request.resource.data.uid == null
        && request.resource.data.guestId == request.resource.data.visitorId
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.matches('guest_[A-Za-z0-9_-]+')
        && request.resource.data.sessionId is string
        && request.resource.data.dateKey is string
        && request.resource.data.enteredAt is timestamp
      );
      allow delete: if isAdmin();
    }

    // Timestamped active-time aggregates, one document per visitor per UTC minute.
    match /visitorActivity/{eventId} {
      allow read: if isAdmin();
      allow create, update: if (
        signedIn()
        && request.resource.data.userType == 'account'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.activeSeconds is number
        && request.resource.data.activeSeconds > 0
        && request.resource.data.timestamp is timestamp
        && eventId.matches('.*_[0-9]{12}')
      ) || (
        !signedIn()
        && request.resource.data.userType == 'guest'
        && request.resource.data.uid == null
        && request.resource.data.guestId == request.resource.data.visitorId
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.matches('guest_[A-Za-z0-9_-]+')
        && request.resource.data.activeSeconds is number
        && request.resource.data.activeSeconds > 0
        && request.resource.data.timestamp is timestamp
        && eventId.matches('guest_[A-Za-z0-9_-]+_[0-9]{12}')
      );
      allow delete: if isAdmin();
    }

    match /problems/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /articles/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /contests/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mathnetProblems/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /mathnetIndexShards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetMeta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetProblemsV2/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /mathnetIndexShardsV2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetPools/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meetings/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
          && (
            (!resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == 1)
            || (resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == resource.data.registrationCount + 1)
          )
          && getAfter(/databases/$(database)/documents/meetings/$(id)/registrations/$(request.auth.uid)).data.userId == request.auth.uid);

      match /registrations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /exams/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
          && (
            (!resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == 1)
            || (resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == resource.data.registrationCount + 1)
          ))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entryCount'])
          && (
            (!resource.data.keys().hasAny(['entryCount']) && request.resource.data.entryCount == 1)
            || (resource.data.keys().hasAny(['entryCount']) && request.resource.data.entryCount == resource.data.entryCount + 1)
          ))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participatedCount'])
          && (
            (!resource.data.keys().hasAny(['participatedCount']) && request.resource.data.participatedCount == 1)
            || (resource.data.keys().hasAny(['participatedCount']) && request.resource.data.participatedCount == resource.data.participatedCount + 1)
          ));

      match /registrations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        // Registration is immutable for normal users so a duplicate create
        // can never silently increment the public registration counter again.
        allow create: if signedIn() && request.auth.uid == uid;
        allow update: if isAdmin();
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      match /submissions/{uid} {
        // Support direct reads by owner and safe collection-group queries
        // filtered by userId, which lets Exam history discover completed exams
        // without probing every exam's submission document.
        allow read: if isAdmin() || (signedIn()
          && (request.auth.uid == uid || resource.data.userId == request.auth.uid));
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    // Collection-group access for a signed-in user's own exam submissions.
    // The userId equality filter in app.js keeps this query scoped to that user.
    match /{path=**}/submissions/{submissionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /books/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == (resource.data.viewCount is number ? resource.data.viewCount : 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
          && request.resource.data.downloadCount == (resource.data.downloadCount is number ? resource.data.downloadCount : 0) + 1
        );
    }

    match /books/{bookId}/views/{viewerId} {
      // One unique-view document per signed-in account or browser-local guest ID.
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == viewerId)
        || viewerId.matches('guest_[A-Za-z0-9_-]+');
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['viewerId','uid','displayName','email','createdAt'])
        && request.resource.data.keys().hasAll(['viewerId','uid','displayName','email','createdAt'])
        && request.resource.data.viewerId == viewerId
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is string
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /books/{bookId}/viewSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['sessionId','bookId','viewerId','uid','displayName','email','userType','startedAt','endedAt','durationSeconds','status'])
        && request.resource.data.keys().hasAll(['sessionId','bookId','viewerId','uid','displayName','email','userType','startedAt','endedAt','durationSeconds','status'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.bookId == bookId
        && request.resource.data.viewerId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.userType in ['account','guest']
        && request.resource.data.startedAt is string
        && request.resource.data.endedAt == null
        && request.resource.data.durationSeconds == 0
        && request.resource.data.status == 'active'
        && ((request.auth == null && request.resource.data.uid == null && request.resource.data.userType == 'guest')
          || (request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.userType == 'account'));
      allow update: if isAdmin()
        || (resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt','durationSeconds','status'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedAt is string
          && request.resource.data.durationSeconds is number
          && request.resource.data.durationSeconds >= resource.data.durationSeconds
          && request.resource.data.viewerId == resource.data.viewerId
          && ((request.auth == null && resource.data.uid == null)
            || (request.auth != null && resource.data.uid == request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /books/{bookId}/downloads/{downloadId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['downloadId','bookId','viewerId','uid','displayName','email','userType','fileName','createdAt'])
        && request.resource.data.keys().hasAll(['downloadId','bookId','viewerId','uid','displayName','email','userType','fileName','createdAt'])
        && request.resource.data.downloadId == downloadId
        && request.resource.data.bookId == bookId
        && request.resource.data.viewerId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.userType in ['account','guest']
        && request.resource.data.fileName is string
        && request.resource.data.createdAt is string
        && ((request.auth == null && request.resource.data.uid == null && request.resource.data.userType == 'guest')
          || (request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.userType == 'account'));
      allow update, delete: if isAdmin();
    }

    match /books/{bookId}/chunks/{chunkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /journals/{uid}/entries/{entryId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }
    match /journalIssues/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == (resource.data.viewCount is number ? resource.data.viewCount : 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
          && request.resource.data.downloadCount == (resource.data.downloadCount is number ? resource.data.downloadCount : 0) + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          )
        );
    }

    match /journalIssues/{journalId}/views/{viewerId} {
      allow get: if isAdmin()
        || (request.auth != null && request.auth.uid == viewerId)
        || viewerId.matches('guest_[A-Za-z0-9_-]+');
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['viewerId','uid','displayName','email','createdAt','journalId'])
        && request.resource.data.keys().hasAll(['viewerId','uid','displayName','email','createdAt','journalId'])
        && request.resource.data.viewerId == viewerId
        && request.resource.data.journalId == journalId
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is string
        && ((request.auth == null && request.resource.data.uid == null)
          || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /journalIssues/{journalId}/viewSessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['sessionId','journalId','viewerId','uid','displayName','email','userType','startedAt','endedAt','durationSeconds','status'])
        && request.resource.data.keys().hasAll(['sessionId','journalId','viewerId','uid','displayName','email','userType','startedAt','endedAt','durationSeconds','status'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.journalId == journalId
        && request.resource.data.viewerId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.userType in ['account','guest']
        && request.resource.data.startedAt is string
        && request.resource.data.endedAt == null
        && request.resource.data.durationSeconds == 0
        && request.resource.data.status == 'active'
        && ((request.auth == null && request.resource.data.uid == null && request.resource.data.userType == 'guest')
          || (request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.userType == 'account'));
      allow update: if isAdmin()
        || (resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt','durationSeconds','status'])
          && request.resource.data.status == 'ended'
          && request.resource.data.endedAt is string
          && request.resource.data.durationSeconds is number
          && request.resource.data.durationSeconds >= resource.data.durationSeconds
          && request.resource.data.viewerId == resource.data.viewerId
          && request.resource.data.journalId == resource.data.journalId
          && ((request.auth == null && resource.data.uid == null)
            || (request.auth != null && resource.data.uid == request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /journalIssues/{journalId}/downloads/{downloadId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['downloadId','journalId','viewerId','uid','displayName','email','userType','fileName','createdAt'])
        && request.resource.data.keys().hasAll(['downloadId','journalId','viewerId','uid','displayName','email','userType','fileName','createdAt'])
        && request.resource.data.downloadId == downloadId
        && request.resource.data.journalId == journalId
        && request.resource.data.viewerId is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.userType in ['account','guest']
        && request.resource.data.fileName is string
        && request.resource.data.createdAt is string
        && ((request.auth == null && request.resource.data.uid == null && request.resource.data.userType == 'guest')
          || (request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.userType == 'account'));
      allow update, delete: if isAdmin();
    }

    match /journalIssues/{journalId}/chunks/{chunkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    // Daily Problem: the current statement is public; only admins can edit it.
    match /dailyProblem/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Every published Daily Problem is kept for the past-problem archive.
    match /dailyProblems/{problemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Approval-order reward counter: only administrators can access this bookkeeping.
    match /dailyProblemRewards/{problemId} {
      allow read, write: if isAdmin();
    }

    // Community solutions are private while pending/rejected and public only after approval.
    match /dailyProblemSubmissions/{submissionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || resource.data.status == 'approved';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','displayName','email','photoURL','language','solution','status','createdAt','problemId'])
        && request.resource.data.keys().hasAll(['uid','displayName','email','solution','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && (!request.resource.data.keys().hasAny(['photoURL']) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 12000))
        && (!request.resource.data.keys().hasAny(['language']) || request.resource.data.language in ['ENG','AZE'])
        && (!request.resource.data.keys().hasAny(['problemId']) || (request.resource.data.problemId is string && request.resource.data.problemId.size() <= 200))
        && request.resource.data.solution is string
        && request.resource.data.solution.size() > 0
        && request.resource.data.solution.size() <= 50000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string;
      allow update, delete: if isAdmin();
    }

  }
}