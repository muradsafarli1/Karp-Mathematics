rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedAccount(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.requiresEmailVerification != true;
    }
    function isAdminUid(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function friendshipId(a,b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(a,b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a,b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a,b))).data.status == 'accepted';
    }
    function conversationMember(data) {
      return verifiedAccount(request.auth.uid) && data.members is list && request.auth.uid in data.members;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && (
          (request.auth.token.email_verified == true
            && request.resource.data.requiresEmailVerification == false)
          ||
          (request.auth.token.email_verified != true
            && request.resource.data.requiresEmailVerification == true)
        );
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiresEmailVerification'])
            || (
              request.auth.token.email_verified == true
              && request.resource.data.requiresEmailVerification == false
            )
          ));
      allow delete: if isAdmin();

      match /solved/{problemId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /saved/{problemId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /mockHistory/{mockId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /privateState/{stateId} {
        allow read, create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /readMarks/{markId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /examEntries/{examId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }

    match /examSessions/{sessionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /about/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if isAdmin() || verifiedAccount(request.auth.uid);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin() || (verifiedAccount(uid) && request.auth.uid == uid);
    }

    match /friendRequests/{requestId} {
      allow read: if isAdmin() || verifiedAccount(request.auth.uid);
      allow create: if verifiedAccount(request.auth.uid)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid));
      allow update: if isAdmin()
        || (verifiedAccount(request.auth.uid) && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status in ['accepted','rejected'])
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'cancelled')
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status in ['rejected','cancelled']
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'pending')
        ));
      allow delete: if isAdmin();
    }

    match /friendships/{friendshipId} {
      allow read: if isAdmin() || (verifiedAccount(request.auth.uid) && resource.data.members is list && request.auth.uid in resource.data.members);
      allow create: if isAdmin()
        || (verifiedAccount(request.auth.uid)
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == 2
          && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && request.resource.data.members[0] != request.resource.data.members[1]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || (verifiedAccount(request.auth.uid) && resource.data.members is list && request.auth.uid in resource.data.members);
      allow create: if isAdmin()
        || (verifiedAccount(request.auth.uid)
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 2
          && request.resource.data.members.size() <= 20
          && request.auth.uid in request.resource.data.members
          && (
            (request.resource.data.type == 'direct'
              && request.resource.data.members.size() == 2
              && conversationId == friendshipId(request.resource.data.members[0],request.resource.data.members[1])
              && isFriend(request.resource.data.members[0],request.resource.data.members[1]))
            ||
            (request.resource.data.type == 'group'
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 1
              && request.resource.data.name.size() <= 80)
            ||
            (request.resource.data.type == 'support'
              && request.resource.data.members.size() == 2
              && request.resource.data.createdBy == request.auth.uid
              && (isAdminUid(request.resource.data.members[0]) || isAdminUid(request.resource.data.members[1])))
          ));
      allow update: if isAdmin()
        || (conversationMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data));
        allow create: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000);
        allow update, delete: if isAdmin();
      }
    }

    match /presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /problems/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /articles/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /contests/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mathnetProblems/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /mathnetIndexShards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetMeta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetProblemsV2/{id} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /mathnetIndexShardsV2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetPools/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meetings/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
          && (
            (!resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == 1)
            || (resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == resource.data.registrationCount + 1)
          )
          && getAfter(/databases/$(database)/documents/meetings/$(id)/registrations/$(request.auth.uid)).data.userId == request.auth.uid);

      match /registrations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /exams/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount'])
          && (
            (!resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == 1)
            || (resource.data.keys().hasAny(['registrationCount']) && request.resource.data.registrationCount == resource.data.registrationCount + 1)
          ))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entryCount'])
          && (
            (!resource.data.keys().hasAny(['entryCount']) && request.resource.data.entryCount == 1)
            || (resource.data.keys().hasAny(['entryCount']) && request.resource.data.entryCount == resource.data.entryCount + 1)
          ))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participatedCount'])
          && (
            (!resource.data.keys().hasAny(['participatedCount']) && request.resource.data.participatedCount == 1)
            || (resource.data.keys().hasAny(['participatedCount']) && request.resource.data.participatedCount == resource.data.participatedCount + 1)
          ));

      match /registrations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      match /submissions/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    match /journals/{uid}/entries/{entryId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }
    match /journalIssues/{journalId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
          && (
            (!resource.data.keys().hasAny(['downloadCount']) && request.resource.data.downloadCount == 1)
            || (resource.data.keys().hasAny(['downloadCount']) && request.resource.data.downloadCount == resource.data.downloadCount + 1)
          ))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
          && (
            (!resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == 1)
            || (resource.data.keys().hasAny(['readCount']) && request.resource.data.readCount == resource.data.readCount + 1)
          ));
    }
    match /journalIssues/{journalId}/chunks/{chunkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

  }
}