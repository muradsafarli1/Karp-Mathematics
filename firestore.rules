rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function friendshipId(a,b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function isFriend(a,b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a,b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a,b))).data.status == 'accepted';
    }
    function conversationMember(data) {
      return signedIn() && data.members is list && request.auth.uid in data.members;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /friendRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        ));
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.toUid));
      allow update: if isAdmin()
        || (signedIn() && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status in ['accepted','rejected'])
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.fromUid == resource.data.fromUid
            && request.resource.data.toUid == resource.data.toUid
            && request.resource.data.status == 'cancelled')
        ));
      allow delete: if isAdmin();
    }

    match /friendships/{friendshipId} {
      allow read: if isAdmin() || (signedIn() && conversationMember(resource.data));
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == 2
          && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestId)).data.status == 'accepted'
          && request.resource.data.members[0] != request.resource.data.members[1]);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || conversationMember(resource.data);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.status == 'accepted'
          && request.resource.data.members is list
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && isFriend(request.resource.data.members[0],request.resource.data.members[1]));
      allow update: if isAdmin() || conversationMember(resource.data);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data));
        allow create: if isAdmin() || (signedIn()
          && conversationMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000);
        allow update, delete: if isAdmin();
      }
    }

    match /problems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /contests/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mathnetProblems/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetIndexShards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetMeta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetProblemsV2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetIndexShardsV2/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /mathnetPools/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /exams/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /registrations/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }

      match /submissions/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      }
    }
  }
}